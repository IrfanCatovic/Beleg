JWT_SECRET=change-me-min-32-characters-long-secret
DATABASE_URL=postgres://user:pass@localhost:5432/planiner?sslmode=disable

# CSV Google OAuth client IDs accepted as ID-token audience (web, Android, iOS).
GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com
